# Local processing uses the existing models folder. Cloud tools are OFF until enabled in the app.
LUMA_TIMEZONE=America/New_York
LUMA_VOICE=luma
LUMA_VOICE_SPEED=0.96
# Optional real providers. Never put card numbers or CVCs here.
BRAVE_SEARCH_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
LUMA_ALLOWED_LIGHTS=light.living_room
# Named HTTPS merchant entry points. Checkout remains in that merchant's own saved wallet.
LUMA_MERCHANTS_JSON={}

# Approved Cal.com appointment services. No paid bookings are submitted.
CAL_COM_API_KEY=
LUMA_CAL_EVENT_TYPES_JSON={}

# Instacart Developer Platform: shoppable list creation, not direct order placement.
INSTACART_API_KEY=
INSTACART_ENVIRONMENT=production
# Choose the Messages route in the local app. Actual OS permission is granted by macOS.
