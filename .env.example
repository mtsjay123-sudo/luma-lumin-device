# Put your Supabase credentials here for Vercel deployment
# Get these from: Project Settings > API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Long random secret for the waitlist admin page (/admin.html). Server-side only.
LUMA_ADMIN_TOKEN=

# --- Luma Cloud: Luma's texting number + Luma Plus (api/luma/[route].js) ---
# Server-only. Never expose the service-role key to a browser or a device.
SUPABASE_SERVICE_ROLE_KEY=
# The public URL of this site, used for Stripe return pages and Twilio webhooks.
LUMA_CLOUD_PUBLIC_URL=https://lumin-holdings-site.vercel.app
# Twilio: account, a Verify service for owner sign-up, and the sending number/service.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# A2P 10DLC (or toll-free verified) Messaging Service that holds Luma's numbers.
TWILIO_MESSAGING_SERVICE_SID=
LUMA_SHARED_NUMBER=+1XXXXXXXXXX
# Plans
LUMA_FREE_TEXTS_PER_MONTH=30
LUMA_PLUS_TEXTS_PER_MONTH=300
LUMA_PLUS_PRICE_LABEL=$9.99/month
LUMA_TEXTS_PER_MINUTE=6
LUMA_TEXT_COUNTRY_CODES=1
# 1 = buy a local number for each Luma Plus subscriber; 1 = release it when they cancel.
LUMA_PROVISION_NUMBERS=1
LUMA_RELEASE_NUMBERS_ON_CANCEL=0
# Stripe: secret key, the Luma Plus monthly price, and the webhook signing secret
# for https://<site>/api/luma/stripe-webhook
STRIPE_SECRET_KEY=
LUMA_PLUS_PRICE_ID=price_1UMMsMHupQXO7siRSIB6U6z3
STRIPE_WEBHOOK_SECRET=
